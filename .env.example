# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth — consumed by supabase/config.toml for `supabase start`.
# Not needed in the app bundle; the hosted project holds these in its dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Push Notifications (Web)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry — crash/error/performance monitoring.
#
# The DSN is the only one the app itself reads at runtime, so it is the only
# EXPO_PUBLIC_ one. It is safe in a client bundle by design (it can only write
# events, never read them).
EXPO_PUBLIC_SENTRY_DSN=
#
# Build-time only, for uploading source maps so production stack traces are
# readable. NEVER prefix these with EXPO_PUBLIC_ — the auth token can create
# releases in your Sentry org and must not ship to users. Set them as EAS
# secrets (`eas secret:create`) for native builds and as Vercel project env
# vars for the web build; a local `npm run build` skips the upload without them.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
